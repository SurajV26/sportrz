# Sportrz MySQL database.
# These are the database name and user from the supplied hosting database.
# IMPORTANT: replace the password placeholder with the real MySQL password.
# On cPanel, localhost refers to the hosting server. On your Windows PC, localhost
# refers to your own PC's MySQL server, not the live hosting database.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=astrotri_sportrz
MYSQL_USER=astrotri_sportrz_user
MYSQL_PASSWORD=PUT_YOUR_REAL_MYSQL_PASSWORD_HERE
MYSQL_SSL=false

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP email delivery for password-free email OTP. Use cPanel's outgoing server settings.
SMTP_HOST=backend.sportrz.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@backend.sportrz.com
SMTP_PASS=put-your-mailbox-password-here
EMAIL_FROM="Sportrz <no-reply@backend.sportrz.com>"

# Optional Google sign-in (without Firebase).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional key-encryption secret. Keep stable between deployments and back it up securely.
SETTINGS_ENCRYPTION_KEY=

# Razorpay defaults (keep secrets server-only). Admin can override keys in the secure admin settings panel after migration.
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
# Optional fallback for the public /api/webhooks/razorpay endpoint. Prefer setting it encrypted in Admin → Settings & Razorpay.
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional Cloudinary uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fixed QA/test accounts (local or deployed QA site).
# true = show and allow password login for users.is_test_account = 1 only.
# false = hide QA login and reject existing QA sessions. Real customer OTP is unaffected.
# Use only on a private QA/staging site or with a separate QA database.
ENABLE_DEV_TEST_ACCOUNTS=false
LIVE_TEST_SUPERADMIN_PASSWORD=
LIVE_TEST_SUBADMIN_PASSWORD=
LIVE_TEST_USER_PASSWORD=
LIVE_TEST_AFFILIATE_PASSWORD=
LIVE_TEST_SEED_CONFIRM=
# Optional path to a private env file used only when running migration/seed scripts locally.
SPORTRZ_ENV_FILE=.env.live-test

# Optional privacy-preserving CPC click fingerprint salt. Keep stable across deployments.
AFFILIATE_FRAUD_SALT=
# Set true only when your reverse proxy overwrites/sanitizes client IP headers before Next.js.
TRUST_PROXY_IP_HEADERS=false
